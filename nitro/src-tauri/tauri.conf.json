{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nitro",
  "version": "0.1.0",
  "identifier": "com.jules.nitro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Nitro",
        "width": 800,
        "height": 400,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "ja-JP"
      },
      "nsis": {
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    }
  }
}
